{
  "name": "dharma-space",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate -w backend",
    "heroku-postbuild": "npm run build:backend",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "seed": "npm run db:seed -w backend",
    "db:push": "npm run db:push -w backend",
    "setup:local": "bash scripts/setup-local-dev.sh",
    "start": "npm run start:prod -w backend",
    "start:prod": "npm run start:prod -w backend"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
