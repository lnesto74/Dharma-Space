# Local: Docker Postgres (see docker-compose.yml) or any PostgreSQL 15+ instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dharma"
JWT_SECRET="change-me-in-production"
PORT=7010
FRONTEND_URL="http://localhost:7011"

# DigitalOcean App Platform (set in DO env vars, do not commit real values):
# DATABASE_URL=${dev-db-191474.DATABASE_URL}
#
# FIRST DEPLOY ONLY — doadmin URI from DO → Databases → Connection Details.
# Database name must be dev-db-191474 (NOT defaultdb). Encrypt in DO. Remove after first deploy.
# DATABASE_MIGRATION_URL=postgresql://doadmin:PASSWORD@HOST:25060/dev-db-191474?sslmode=require

# ── Google Workspace SMTP (dharma-space.com) ───────────────────────────────────
# Each mailbox needs 2-Step Verification + an App Password (Mail).
# Google Account → Security → App passwords → paste 16-char password below.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Education bookings / waitlists — team inbox + sends from education@
SMTP_EDUCATION_USER=education@dharma-space.com
SMTP_EDUCATION_PASS=
SMTP_EDUCATION_FROM="Dharma Space <education@dharma-space.com>"
MAIL_EDUCATION_INBOX=education@dharma-space.com

# Corporate contact form — team inbox + sends from corporate@
SMTP_CORPORATE_USER=corporate@dharma-space.com
SMTP_CORPORATE_PASS=
SMTP_CORPORATE_FROM="Dharma Space <corporate@dharma-space.com>"
MAIL_CORPORATE_INBOX=corporate@dharma-space.com

# CC on team notification emails (e.g. vera@dharma-space.com)
MAIL_NOTIFY=vera@dharma-space.com

# Optional — website header admin login (username: admin)
SITE_ADMIN_PASS=admin

# Corporate portal — Google OAuth (Web client)
# Authorized origins: https://corporate.dharma-space.com, http://localhost:7011, http://corporate.localhost:7011
GOOGLE_CLIENT_ID=
# Optional comma-separated allowlist (defaults to any @dharma-space.com email)
CORPORATE_ALLOWED_DOMAINS=dharma-space.com
CORPORATE_URL=https://corporate.dharma-space.com

# ScrapeGraphAI — trainer profile import from website / Instagram / LinkedIn
# Free tier: 500 credits at https://scrapegraphai.com
SGAI_API_KEY=
# SGAI_API_URL=https://v2-api.scrapegraphai.com/api

